generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  items      Item[]
  activities Activity[]
  persons    Person[]
  pricings   Pricing[]
  createdAt  DateTime   @default(now())
}

model Item {
  id          String   @id @default(uuid())
  name        String
  description String?
  quantity    Int      @default(0)
  price       Float?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Person {
  id         String     @id @default(uuid())
  name       String
  phone      String?
  email      String?
  notes      String?
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]
  createdAt  DateTime   @default(now())
}

model Activity {
  id           String            @id @default(uuid())
  title        String
  description  String?
  activityDate DateTime
  time         String?
  status       String            @default("pending")
  price        Float?
  personId     String?
  person       Person?           @relation(fields: [personId], references: [id], onDelete: SetNull)
  pricings     ActivityPricing[]
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@index([activityDate])
}

model Pricing {
  id          String            @id @default(uuid())
  name        String
  description String?
  price       Float
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities  ActivityPricing[]
  createdAt   DateTime          @default(now())
}

model ActivityPricing {
  activityId String
  pricingId  String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  pricing    Pricing  @relation(fields: [pricingId], references: [id], onDelete: Cascade)

  @@id([activityId, pricingId])
}

model SystemConfig {
  id           String  @id @default("default")
  companyName  String  @default("ERP System")
  logoUrl      String?
  primaryColor String  @default("#0d6efd")
  address      String?
  phone        String?
  email        String?
  updatedAt    DateTime @updatedAt
}